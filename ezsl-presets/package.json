{
  "name": "ezsl-presets",
  "version": "0.1.0",
  "description": "Reusable EZSL shader effect presets (noise, SDF primitives, color grading, blur/bloom) for EZSL.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./noise": {
      "types": "./dist/noise.d.ts",
      "import": "./dist/noise.js"
    },
    "./sdf": {
      "types": "./dist/sdf.d.ts",
      "import": "./dist/sdf.js"
    },
    "./colorGrading": {
      "types": "./dist/colorGrading.d.ts",
      "import": "./dist/colorGrading.js"
    },
    "./blurBloom": {
      "types": "./dist/blurBloom.d.ts",
      "import": "./dist/blurBloom.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js"
  },
  "license": "MIT",
  "author": "Patrick JAILLET",
  "peerDependencies": {
    "@patrickjaillet/ezsl": "*"
  },
  "devDependencies": {
    "@patrickjaillet/ezsl": "file:..",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.14"
  }
}
