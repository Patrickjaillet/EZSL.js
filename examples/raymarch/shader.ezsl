ro = [0.0, 0.0, -3.0]
centered = uv - [0.5, 0.5]
rd = normalize([centered.x, centered.y, 1.0])

sphereCenter = [sin(time), 0.0, 0.0]

t = 0.0
hit = 0.0

for i in 0..64 {
  p = ro + rd * t
  d = length(p - sphereCenter) - 1.0
  if d < 0.001 {
    hit = 1.0
  }
  t = t + d * 0.5
}

shade = 1.0 - t * 0.15
color = [hit * shade, hit * shade * 0.8, hit * shade]
