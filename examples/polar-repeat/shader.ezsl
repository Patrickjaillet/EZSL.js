center = uv - [0.5, 0.5]
angle = atan(center.y, center.x)
radius = length(center)

segments = 8.0
segmentAngle = 6.28318 / segments
wrapped = mod(angle, segmentAngle) - segmentAngle * 0.5

px = cos(wrapped) * radius
py = sin(wrapped) * radius

bar = smoothstep(0.05, 0.03, abs(py))
ring = smoothstep(0.4, 0.38, radius) * smoothstep(0.1, 0.12, radius)

glow = bar * ring

color = [glow, glow * 0.7, glow * 1.0]
