{
  "name": "ezsl-vscode",
  "displayName": "EZSL",
  "description": "Syntax highlighting and inferred-type hover tooltips for EZSL.js (.ezsl) shader files",
  "version": "0.1.0",
  "publisher": "ezsl",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "ezsl",
        "aliases": [
          "EZSL",
          "ezsl"
        ],
        "extensions": [
          ".ezsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ezsl",
        "scopeName": "source.ezsl",
        "path": "./syntaxes/ezsl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@patrickjaillet/ezsl": "file:.."
  }
}
